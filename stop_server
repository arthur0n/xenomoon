#!/usr/bin/env bash
# Stop the UI server started by ./start_server.
#
# The PID file is a HINT, not the truth. A server outlives its pid file in ordinary ways — the file
# is emptied or lost, the install directory is renamed under a running process, a start is
# interrupted between spawn and write. When that happened here, `stop` read a PID that was already
# gone, said so, deleted the file, and left a real server running for another 34 hours — serving a
# tree that no longer existed at that path, and untrackable by its own tooling.
#
# So: try the PID file, THEN check whether anything is still listening on this install's port, and
# stop it when it belongs to this install.
#
# EXIT CODES — the caller needs to tell "stopped" from "could not tell":
#   0  the check completed: something of ours was stopped, or nothing of ours was running
#   3  INDETERMINATE — the port could not be inspected, so a server may still be running. The pid
#      file is kept, and `xenomoon restart` refuses to start on top of it.
set -euo pipefail
cd "$(dirname "$0")"
# Port resolution and the ownership rule are SHARED with start_server — see the file's header for
# why they may never be answered twice.
. ./server-port.sh

stopped_any=""
pid_was_stale=""

PIDFILE=".xm-run/ui.pid"

# Every "I could not check" exit goes through here, so the pid file is kept and the caller is told,
# in one place. Losing the hint after a check that never ran is what makes the next stop blinder
# than this one.
give_up() {
  echo "$1"
  if [ -n "$pid_was_stale" ]; then
    echo "  Keeping $PIDFILE: the port check did not complete."
  fi
  echo "  A server of this install's may still be running — stop it by hand before starting another."
  exit 3
}

if [ -f "$PIDFILE" ]; then
  pid="$(cat "$PIDFILE" 2>/dev/null || true)"
  # PROVE it is ours before signalling. The file is a number we wrote hours ago, and the OS reuses
  # numbers — an unproven kill here would land on whatever inherited it. Nothing about the port scan
  # below can undo a signal already sent, which is why the proof comes first.
  if [ -n "$pid" ] && is_our_server_process "$pid"; then
    # Wait for it to actually die. "Signal sent" is not "stopped": a server that is SIGSTOPped or
    # stuck in shutdown keeps the port, and saying otherwise while deleting the pid file is how a
    # restart ends up starting a sibling on a port that was never freed.
    stop_proven_pid "$pid" ||
      give_up "PID $pid is this install's server and would not stop, even forced."
    echo "Stopped PID $pid."
    stopped_any=1
    rm -f "$PIDFILE"
  else
    # Do NOT delete it yet. It is the last durable record of what this install started, and if the
    # port check below cannot run — no lsof, no permission — throwing it away makes the next
    # attempt blinder than this one.
    pid_was_stale=1
    if [ -z "$pid" ]; then
      : # an empty pid file says nothing; the port check is the whole answer
    elif kill -0 "$pid" 2>/dev/null; then
      echo "PID $pid (from $PIDFILE) is alive but is not this install's server — left alone. Checking the port."
    else
      echo "PID $pid (from $PIDFILE) is already gone — checking the port."
    fi
  fi
fi

command -v lsof >/dev/null 2>&1 ||
  give_up "lsof not available — cannot check port $PORT for an untracked server."

port_listeners
if [ -z "$PORT_LISTENERS" ] && [ -n "$LSOF_COMPLAINT" ]; then
  give_up "Could not inspect port $PORT for an untracked server: $LSOF_COMPLAINT"
fi

unreadable=""
for p in $PORT_LISTENERS; do
  owner_cwd="$(listener_cwd "$p")"
  # An unreadable cwd is NOT a foreign process. Treating it as one would leave a possibly-ours
  # server running while the run still counted as a completed check — the same orphan, reached by
  # a quieter road.
  #
  # But it is not a reason to stop looking either. A port can list several listeners in an order
  # that means nothing, so bailing on the first unreadable one would abandon a server of ours that
  # was one line further down and perfectly stoppable. Note it, keep going, and settle up after.
  if [ -z "$owner_cwd" ]; then
    echo "PID $p is listening on $PORT but its working directory could not be read — cannot tell whose it is."
    unreadable=1
    continue
  fi
  # The same two-factor proof the pid path uses: our server entry AND our directory. A cwd inside
  # this install is not enough on its own — a service the user happened to start from here would
  # match, and stopping the UI server is no reason to kill it.
  if is_our_server_process "$p"; then
    if stop_proven_pid "$p"; then
      echo "Stopped PID $p (was listening on $PORT, untracked by $PIDFILE)."
      stopped_any=1
    else
      give_up "PID $p on $PORT is this install's server and would not stop, even forced."
    fi
  else
    # Another install — or an unrelated program holding the port — is not ours to kill, and killing
    # it would be the worst kind of helpful.
    echo "Port $PORT is held by PID $p from $owner_cwd — not this install's server, left alone."
  fi
done

# Everything stoppable has been stopped by now — but if any listener stayed unidentifiable, the
# check did not complete, so the answer is still "I cannot tell you the port is free".
if [ -n "$unreadable" ]; then
  give_up "Not every listener on $PORT could be identified."
fi

# The port check completed, so the pid file has done its job.
[ -n "$pid_was_stale" ] && rm -f "$PIDFILE"
[ -n "$stopped_any" ] || echo "Nothing of this install's was running."
exit 0
