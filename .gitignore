node_modules/
.DS_Store

# Local secrets / env — never commit. Tracked `*.example` templates are the only
# committed env files (gitleaks allowlists them).
.env
.env.*
!.env.example
!*.env.example

logs/
opendocs/
game_assets/

# Your saved game-project path (written by `npm run setup`). Local to each
# fork — the framework is independent of which project it points at.
.xenomoon.json

# Optional, vendored-on-demand third-party plugins (e.g. OpenAI's codex-plugin-cc,
# cloned by `npm run codex:setup`). Not part of the framework — never committed.
vendor/

# graphify knowledge graph of the framework itself — derived, rebuilt by the graphify CLI.
graphify-out/

# Detached `npm run start:bg` process records (PID + log per game) — runtime, machine-local.
.xenomoon-run/

# UI server runtime records/logs — machine-local; a tracked log here blocks every
# `xenomoon update` (git refuses the ff-merge over a locally-modified file).
.xm-run/

# Sub-agent handoff documents written under the plugin at runtime — machine-local, not shipped.
plugin/.xenomoon/

# Personal untracked hook extensions (sourced by .husky/post-commit when present).
.husky/post-commit.local

# Paths a DOMAIN-PACK INSTALL writes into the single capability tree. The trunk must never
# track one: `xenomoon update` ff-merges, and git refuses to overwrite a locally-written file
# at a tracked path — tracking this one broke update in every bound clone (fixed 376c614).
# The pack's own copy under domains/<name>/plugin/ IS tracked; only the installed path is not.
/plugin/library/sources/skill-sources.md

.claude/token-audits/history.html
