node_modules/
.DS_Store

# Local secrets / env — never commit. Tracked `*.example` templates are the only
# committed env files (gitleaks allowlists them).
.env
.env.*
!.env.example
!*.env.example

logs/
opendocs/
game_assets/

# Your saved game-project path (written by `npm run setup`). Local to each
# fork — the framework is independent of which project it points at.
.xenomoon.json

# Optional, vendored-on-demand third-party plugins (e.g. OpenAI's codex-plugin-cc,
# cloned by `npm run codex:setup`). Not part of the framework — never committed.
vendor/

# graphify knowledge graph of the framework itself — derived, rebuilt by the graphify CLI.
graphify-out/

# Detached `npm run start:bg` process records (PID + log per game) — runtime, machine-local.
.xenomoon-run/

# UI server runtime records/logs — machine-local; a tracked log here blocks every
# `xenomoon update` (git refuses the ff-merge over a locally-modified file).
.xm-run/

# Sub-agent handoff documents written under the plugin at runtime — machine-local, not shipped.
plugin/.xenomoon/

# Session state this clone writes for ITSELF (debrief queue, handoffs) when it drives a project —
# the same shape as <project>/.xenomoon/, machine-local, never framework content.
/.xenomoon/

# Personal untracked hook extensions (sourced by .husky/post-commit when present).
.husky/post-commit.local

# NOTE: paths a DOMAIN-PACK INSTALL writes into the capability tree are NOT listed here any
# more. The install declares its own output in a generated `plugin/.gitignore`
# (ui/server/core/install-output.js) — the writers know exactly what they wrote, so the list is
# derived instead of hand-maintained, and it shrinks when a pack stops shipping a path. This
# block used to carry one such path by hand; tracking it once broke `xenomoon update` in every
# bound clone (fixed 376c614), which is the failure the generated manifest now prevents by
# construction.

.claude/token-audits/history.html

# Generated view of the audit ledger (LEDGER.json is the source, LEDGER.md the committed view).
.claude/framework-audits/ledger.html
